rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ingelogd() {
      return request.auth != null && request.auth.token.verified == true;
    }

    function uitgaveVeldenGeldig(d) {
      return d.keys().hasOnly(['datum', 'bedrag', 'valuta', 'categorie', 'omschrijving', 'reisId', 'aangemaaktOp'])
        && d.keys().hasAll(['datum', 'bedrag', 'valuta', 'categorie', 'omschrijving', 'reisId', 'aangemaaktOp'])
        && d.datum is string
        && d.datum.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && d.bedrag is number
        && d.bedrag > 0
        && d.bedrag < 1000000
        && d.valuta in ['EUR', 'USD', 'GBP', 'TRY', 'THB', 'JPY', 'MAD', 'AED', 'PLN', 'CZK', 'HUF', 'MXN']
        && d.categorie in ['eten', 'vervoer', 'verblijf', 'activiteit', 'shopping', 'overig']
        && d.omschrijving is string
        && d.omschrijving.size() <= 80
        && d.reisId is string
        && d.reisId.size() > 0
        && d.reisId.size() < 64;
    }

    function geldigeUitgaveCreate(d) {
      return uitgaveVeldenGeldig(d) && d.aangemaaktOp == request.time;
    }

    function geldigeUitgaveUpdate(nieuw, oud) {
      return uitgaveVeldenGeldig(nieuw)
        && nieuw.reisId == oud.reisId
        && nieuw.aangemaaktOp == oud.aangemaaktOp;
    }

    function geldigeReisCreate(d) {
      return d.keys().hasOnly(['naam', 'startDatum', 'eindDatum', 'archief', 'aangemaaktOp'])
        && d.keys().hasAll(['naam', 'startDatum', 'archief', 'aangemaaktOp'])
        && d.naam is string
        && d.naam.size() > 0
        && d.naam.size() <= 60
        && d.startDatum is string
        && d.startDatum.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('eindDatum' in d.keys()) || (d.eindDatum is string && d.eindDatum.matches('^\\d{4}-\\d{2}-\\d{2}$')))
        && d.archief is bool
        && d.aangemaaktOp == request.time;
    }

    function geldigeReisUpdate(nieuw, oud) {
      return nieuw.keys().hasOnly(['naam', 'startDatum', 'eindDatum', 'archief', 'aangemaaktOp'])
        && nieuw.keys().hasAll(['naam', 'startDatum', 'archief'])
        && nieuw.naam is string
        && nieuw.naam.size() > 0
        && nieuw.naam.size() <= 60
        && nieuw.startDatum is string
        && nieuw.startDatum.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('eindDatum' in nieuw.keys()) || (nieuw.eindDatum is string && nieuw.eindDatum.matches('^\\d{4}-\\d{2}-\\d{2}$')))
        && nieuw.archief is bool
        && nieuw.aangemaaktOp == oud.aangemaaktOp;
    }

    match /uitgaven/{doc} {
      allow read: if ingelogd();
      allow create: if ingelogd() && geldigeUitgaveCreate(request.resource.data);
      allow update: if ingelogd() && geldigeUitgaveUpdate(request.resource.data, resource.data);
      allow delete: if ingelogd();
    }

    match /reizen/{doc} {
      allow read: if ingelogd();
      allow create: if ingelogd() && geldigeReisCreate(request.resource.data);
      allow update: if ingelogd() && geldigeReisUpdate(request.resource.data, resource.data);
      allow delete: if ingelogd();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
